{
  "id": "paysplit",
  "name": "PaySplit",
  "short_description": "Split incoming wallet payments to LNURL-pay targets.",
  "version": "0.1.1",
  "min_lnbits_version": "1.5.5",
  "extension_type": "wasm",
  "wasm": {
    "module": "wasm/module.wasm",
    "exports": [
      {
        "name": "list-wallets",
        "visibility": "authenticated"
      },
      {
        "name": "get-source",
        "visibility": "authenticated"
      },
      {
        "name": "save-source",
        "visibility": "authenticated"
      },
      {
        "name": "delete-source",
        "visibility": "authenticated"
      },
      {
        "name": "record-payment",
        "visibility": "event"
      }
    ]
  },
  "events": {
    "onInvoicePaid": "record-payment"
  },
  "ui_routes": [
    {
      "path": "/paysplit",
      "entrypoint": "ui/admin.html",
      "auth": "user"
    }
  ],
  "openapi": "wasm/openapi.json",
  "api_routes": [
    {
      "method": "GET",
      "path": "/wallets",
      "export": "list-wallets",
      "auth": "user"
    },
    {
      "method": "GET",
      "path": "/sources/{wallet_id}",
      "export": "get-source",
      "auth": "user",
      "path_params": {
        "wallet_id": "walletId"
      }
    },
    {
      "method": "POST",
      "path": "/sources",
      "export": "save-source",
      "auth": "user"
    },
    {
      "method": "DELETE",
      "path": "/sources/{wallet_id}",
      "export": "delete-source",
      "auth": "user",
      "path_params": {
        "wallet_id": "walletId"
      }
    }
  ],
  "permissions": [
    {
      "id": "wallet.list",
      "description": "List wallets so the user can choose source wallets."
    },
    {
      "id": "wallet.payments.watch",
      "description": "Receive payment notifications for approved source wallets."
    },
    {
      "id": "wallet.pay_invoice_background",
      "description": "Send configured split payments from approved source wallets."
    },
    {
      "id": "ext.storage.read",
      "description": "Read PaySplit source wallet and target configuration."
    },
    {
      "id": "ext.storage.write",
      "description": "Save PaySplit source wallet and target configuration."
    }
  ]
}
